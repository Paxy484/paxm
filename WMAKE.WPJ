# =========================================================================
# Pax MIDI Open Watcom Cross-Platform Makefile
# Target: 32-Bit DOS Protected Mode (DOS/4GW)
# =========================================================================

CC      = wcl386
AR      = wlib

# Compiler-only flags: clean from linker actions
CFLAGS  = -od -zq -bt=dos -std=c99

TARGET  = paxm.lib
SRC     = paxm.c
OBJ     = paxm.obj

all : $(TARGET)

$(TARGET) : $(OBJ)
	$(AR) -q -n $(TARGET) +$(OBJ)

$(OBJ) : $(SRC)
	$(CC) $(CFLAGS) -c $(SRC)

clean : .SYMBOLIC
	del *.obj
	del *.lib