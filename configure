#!/bin/sh

# Initialize flag state trackers
DEBUG_MODE="no"

# Pure POSIX argument parser loop
for arg in "$@"; do
    case "$arg" in
        -debug|--debug)
            DEBUG_MODE="yes"
            ;;
        *)
            echo "[WARNING] Unknown configuration parameter: $arg" >&2
            ;;
    esac
done

CC="cc"
printf "checking for cc... "
if command -v cc >/dev/null 2>&1; then
    echo "yes"
else
    echo "no"
    echo "[ERROR] System compiler 'cc' not found." >&2
    exit 1
fi

# Hardened validation tracking check for the system linker tool
LD="ld"
printf "checking for ld... "
if command -v ld >/dev/null 2>&1; then
    echo "yes"
else
    echo "no"
    echo "[ERROR] linker 'ld' not found." >&2
    exit 1
fi

# 2. Set final cross-platform flags and target layouts
EXE=""
IS_WINDOWS="no"

if [ "$DEBUG_MODE" = "yes" ]; then
    printf "configure: configuring build for DEBUGGING... \n"
    CFLAGS="-Wall -Wextra -g -O0 -Iinclude"
else
    CFLAGS="-Wall -Wextra -Iinclude"
fi

LIBS="-lm"

case "$(uname -s 2>/dev/null)" in
    *MINGW*|*MSYS*)
        EXE=".exe"
        IS_WINDOWS="yes"
        ;;
    *)
        # Keep standard POSIX limits intact
        ;;
esac

# Instantiate a true POSIX Tab variable to guarantee rule separators
T=$(printf '\t')

# 3. Output the completed local build rules Makefile (Configured for multiple targets)
printf "configure: creating Makefile... "
cat << EOF > Makefile
CC = $CC
LD = $LD
CFLAGS = $CFLAGS
LIBS = $LIBS

MID2PAXM = mid2paxm$EXE
PAXM2CSV = paxm2csv$EXE
CSV2PAXM = csv2paxm$EXE
PAXM2MID = paxm2mid$EXE

TARGETS = \$(MID2PAXM) \$(PAXM2CSV) \$(CSV2PAXM) \$(PAXM2MID)

all: \$(TARGETS)

src/paxm.o: src/paxm.c include/paxm.h
${T}\$(CC) \$(CFLAGS) -c src/paxm.c -o src/paxm.o

\$(MID2PAXM): src/mid2paxm.c src/paxm.o
${T}\$(CC) \$(CFLAGS) src/mid2paxm.c src/paxm.o -o \$(MID2PAXM) \$(LIBS)

\$(PAXM2CSV): src/paxm2csv.c src/paxm.o
${T}\$(CC) \$(CFLAGS) src/paxm2csv.c src/paxm.o -o \$(PAXM2CSV) \$(LIBS)

\$(CSV2PAXM): src/csv2paxm.c src/paxm.o
${T}\$(CC) \$(CFLAGS) src/csv2paxm.c src/paxm.o -o \$(CSV2PAXM) \$(LIBS)

\$(PAXM2MID): src/paxm2mid.c src/paxm.o
${T}\$(CC) \$(CFLAGS) src/paxm2mid.c src/paxm.o -o \$(PAXM2MID) \$(LIBS)

clean:
${T}rm -f src/*.o \$(TARGETS)

distclean: clean
${T}rm -f Makefile

.PHONY: all clean distclean
EOF
echo "done"